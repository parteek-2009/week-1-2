# Auto detect text files and perform LF normalization
* text=auto
# Normalize line endings for text files
* text=auto eol=lf

# Source code
*.py text diff=python
*.md text
*.tex text diff=tex
*.bib text

# Data files — treat as text so diffs are readable, but don't let git
# try to merge them line-by-line in ways that produce invalid JSON
*.json text eol=lf

# Documentation / deliverables
*.pdf   -text diff=astextplain binary
*.docx  -text binary
*.png   -text binary
*.jpg   -text binary
*.jpeg  -text binary

# Jupyter notebooks — avoid noisy diffs on output cells/metadata
*.ipynb text eol=lf

# Keep results/ reproducible-looking in diffs but don't merge them automatically
results/*.json text eol=lf merge=ours

# Mark generated/large artifacts as not-for-linguist-stats (keeps GitHub's
# "Languages" bar meaningful — shows Python, not JSON/PDF bulk)
*.json linguist-generated=true
results/*.json linguist-generated=true
paper/figures/*.png linguist-generated=true
